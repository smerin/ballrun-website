---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ContentSection from '../components/ContentSection.astro';
import ImageContentColumns from '../components/ImageContentColumns.astro';
import Quote from '../components/Quote.astro';
import woodenBallsImage from '../assets/images/wooden-ball-company-aerial-view.jpg';
import gppEden051 from '../assets/images/gpp-eden-051-landscape.jpg';
import gppEden112 from '../assets/images/gpp-eden-112.jpg';
import gppEden072 from '../assets/images/gpp-eden-072.jpg';
---

<Base
  title="About | Ball Run"
  description="Ball Run is a social enterprise bringing hand-built play installations to urban spaces. Sustainable timber balls, crafted in our solar-powered Somerset workshop."
>
  <Hero
    title="About Ball Run"
    description="A social enterprise on a mission to get more play into everyday town and city life."
    image={woodenBallsImage}
    imageAlt="Aerial view of wooden ball workshop"
  />

  <ImageContentColumns
    title="Who We Are"
    description="<p>The Ball Run is brought to you by Oddball CIC - a social enterprise on a mission to get more play into everyday town and city life. We design, build, and install play installations wherever there's room for them - squares, parks, streets, beachfronts, and everywhere in between - so play becomes part of everyday life, not something you have to seek out.</p>"
    image={{ src: gppEden051, alt: "Ball Run installation at Eden Project" }}
    layout="image-left"
  />

  <section class="inspiration-section">
    <div class="inspiration-section__inner">
      <h2>Why We Do This</h2>
      <p>The idea for Ball Run came from an unexpected place - a family holiday in the Swiss Alps.</p>
      <Quote
        quote="After visiting the Bobosco trail in Switzerland, my 7-year-old walked 9km in a single day - excited to see what was around the next corner. That's when I realised play could transform how families move through the world together."
        attribution="Simon Jackman, Founder"
      />
    </div>
  </section>

  <ImageContentColumns
    title="The Craft"
    description="<p>Every run is designed and hand-built by our team, led by Simon Jackman, who has spent more than 20 years building sustainable playgrounds and play equipment, John Packer and Ruby Myers. Each installation is built to last - built to handle the weather, the crowds, and years of play, wherever it ends up.</p>"
    image={{ src: gppEden112, alt: "Crafting a Ball Run installation" }}
    layout="image-right"
    variant="white"
  />

  <ImageContentColumns
    title="The Balls"
    description="<p>Our balls are turned from sustainable, FSC certified timber, made in our solar-powered workshop in Somerset. Buy one, keep it as a souvenir, and come back as often as you like.</p>"
    image={{ src: woodenBallsImage, alt: "Wooden balls aerial view" }}
    layout="image-left"
  />

  <ContentSection
    title="Proven Ground"
    description="<p>Before Ball Run brought this experience to the city, our sister organisations, <a href='https://www.greenplayproject.co.uk/'>Green Play Project</a> and <a href='https://www.thewoodenballcompany.com/'>The Wooden Ball Company</a>, proved it in the wild. Their installations at the Eden Project and Forestry England sites, including Alice Holt Forest, have been a firm favourite with visitors of all ages - and now we're bringing that same experience to towns and cities.</p>"
    backgroundImage={{ src: gppEden072, alt: "Ball Run installation at Eden Project" }}
  />
</Base>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .inspiration-section {
    background-color: $color-forest;
    color: $color-white;
    padding: $spacing-unit * 8 $spacing-unit * 3;

    @include breakpoint(md) {
      padding: $spacing-unit * 12 $spacing-unit * 8;
    }
  }

  .inspiration-section__inner {
    max-width: 70rem;
    margin: 0 auto;

    h2 {
      margin-bottom: $spacing-unit * 2;
    }

    > p {
      margin-bottom: $spacing-unit * 4;
    }
  }
</style>
