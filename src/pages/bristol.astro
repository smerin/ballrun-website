---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ContentSection from '../components/ContentSection.astro';
import bristolImage from '../assets/images/millenium-square-planetarium.jpg';
---

<Base
  title="The Great Bristol Ball Run | Ball Run"
  description="Six ball runs across Anchor Square and Millennium Square in Bristol. Find us from 3rd August. Race, balance, and explore Bristol's playable city experience."
>
  <Hero
    title="The Great Bristol Ball Run"
    description="Six runs across Anchor Square and Millennium Square - each built differently, with unique challenges and ways to play and explore."
    image={bristolImage}
    imageAlt="Millennium Square planetarium and water features"
  />

  <ContentSection
    title="Six Runs. Two Squares. Endless Play."
    description="<p>Race a friend through a labyrinth of spinning discs by the Aquarium. Send balls flying through a skittle run near the harbourside. Balance your way along a tilting, wavy channel, or steer through a hands-on tabletop maze nearby. Beside the fountains on Millennium Square, take on our longest city run - watch a ball climb an Archimedes screw lift before setting off on an overhead wire track.</p>"
  />

  <ContentSection
    title="Get Your Balls"
    description="<p>Get your balls from We The Curious shop and use as often as you want. Every run on the trail is built to surprise and encourage play and curiosity.</p>"
    variant="white"
  />

  <ContentSection
    title="Just the Beginning"
    description="<p>This pop-up is just the beginning. We want to make Bristol the UK's first truly playable city - with Ball Run installations woven into daily life right across it - and then take that same ambition to towns and cities across the country.</p>"
  />
</Base>
