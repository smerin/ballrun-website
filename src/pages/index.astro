---
import Base from '../layouts/Base.astro';
---

<Base title="Ball Run - Coming Soon">
  <main class="hero">
    <div class="container">
      <h1>Coming soon...</h1>
    </div>
  </main>
</Base>

<style lang="scss">
  @use '../styles/variables' as *;

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: $color-charcoal;
    color: $color-stone;
  }

  .container {
    text-align: center;
    padding: $spacing-unit * 4;
  }
</style>
