---
import { Image } from "astro:assets";
import Button from "./Button.astro";

interface Props {
  title: string;
  description: string;
  buttonText?: string;
  buttonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  video?: string;
  videoMobile?: string;
}

const { title, description, buttonText, buttonHref, secondaryButtonText, secondaryButtonHref, image, imageAlt, video, videoMobile } =
  Astro.props;
---

<section class="hero">
  {video ? (
    <video
      class="hero__media"
      autoplay
      loop
      muted
      playsinline
      aria-hidden="true"
    >
      {videoMobile && <source src={videoMobile} media="(max-width: 768px)" type="video/mp4" />}
      <source src={video} type="video/mp4" />
    </video>
  ) : image && (
    <Image
      src={image}
      alt={imageAlt || ""}
      class="hero__media"
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <h1>{title}</h1>
    <p>{description}</p>
    {
      (buttonText || secondaryButtonText) && (
        <div class="hero__buttons">
          {buttonText && buttonHref && (
            <Button href={buttonHref} arrow>
              {buttonText}
            </Button>
          )}
          {secondaryButtonText && secondaryButtonHref && (
            <Button href={secondaryButtonHref} arrow variant="outline">
              {secondaryButtonText}
            </Button>
          )}
        </div>
      )
    }
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/mixins" as *;

  .hero {
    --header-height: 11.6rem;

    position: relative;
    height: calc(100svh - var(--header-height));
    max-height: 70rem;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: $spacing-unit solid $color-white;
    box-shadow: 0 0 3rem rgba(0, 0, 0, 0.2);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0,
      rgba(0, 0, 0, 0.8) 100%
    );
    z-index: -1;
  }

  .hero__content {
    padding: $spacing-unit * 3;
    color: $color-white;

    @include breakpoint(md) {
      padding: $spacing-unit * 4;
    }

    @include breakpoint(lg) {
      padding: $spacing-unit * 8;
    }

    p {
      max-width: 70rem;
    }
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-unit * 2;
  }
</style>
