---
interface Props {
  announcementText?: string;
}

const { announcementText = "Coming to Millenium Square • 3rd August" } = Astro.props;

const navLinks = [
  { label: "Bristol", href: "/bristol" },
  { label: "About", href: "/about" },
  { label: "Partners", href: "/partners" },
];
---

<header class="site-header">
  <div class="site-header__top">
    {announcementText && (
      <div class="site-header__announcement">
        {announcementText}
      </div>
    )}
  </div>

  <div class="site-header__navbar">
    <div class="site-header__inner">
      <a href="/" class="site-header__logo">
        <img src="/logos/ballrun-logo.svg" alt="Ball Run" />
      </a>

      <nav class="site-header__nav">
        {navLinks.map((link) => (
          <a href={link.href} class="site-header__nav-link">
            {link.label}
          </a>
        ))}
      </nav>

      <button class="site-header__hamburger" aria-label="Open menu" aria-expanded="false">
        <span class="site-header__hamburger-line"></span>
        <span class="site-header__hamburger-line"></span>
        <span class="site-header__hamburger-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Nav Overlay -->
<div class="mobile-nav" aria-hidden="true">
  <div class="mobile-nav__overlay"></div>
  <div class="mobile-nav__panel">
    <button class="mobile-nav__close" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <nav class="mobile-nav__links">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-nav__link">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mobile-nav__contact">
      <h4 class="mobile-nav__heading">Contact</h4>
      <a href="mailto:ben@ballrun.co.uk" class="mobile-nav__contact-link">
        ben@ballrun.co.uk
      </a>
      <a href="tel:07588610389" class="mobile-nav__contact-link">
        07588 610389
      </a>
    </div>
  </div>
</div>

<script>
  const hamburger = document.querySelector('.site-header__hamburger') as HTMLButtonElement | null;
  const mobileNav = document.querySelector('.mobile-nav');
  const mobileNavPanel = document.querySelector('.mobile-nav__panel');
  const closeBtn = document.querySelector('.mobile-nav__close') as HTMLButtonElement | null;
  const overlay = document.querySelector('.mobile-nav__overlay');

  function getFocusableElements(): HTMLElement[] {
    if (!mobileNavPanel) return [];
    const elements = mobileNavPanel.querySelectorAll<HTMLElement>(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    return Array.from(elements);
  }

  function handleTabKey(e: KeyboardEvent) {
    if (!mobileNav?.classList.contains('is-open')) return;
    if (e.key !== 'Tab') return;

    const focusable = getFocusableElements();
    if (focusable.length === 0) return;

    const firstElement = focusable[0];
    const lastElement = focusable[focusable.length - 1];

    if (e.shiftKey) {
      // Shift + Tab: if on first element, go to last
      if (document.activeElement === firstElement) {
        e.preventDefault();
        lastElement.focus();
      }
    } else {
      // Tab: if on last element, go to first
      if (document.activeElement === lastElement) {
        e.preventDefault();
        firstElement.focus();
      }
    }
  }

  function openMenu() {
    mobileNav?.classList.add('is-open');
    mobileNav?.setAttribute('aria-hidden', 'false');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';

    // Focus the close button
    closeBtn?.focus();
  }

  function closeMenu() {
    mobileNav?.classList.remove('is-open');
    mobileNav?.setAttribute('aria-hidden', 'true');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    // Return focus to hamburger button
    hamburger?.focus();
  }

  hamburger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (!mobileNav?.classList.contains('is-open')) return;

    if (e.key === 'Escape') {
      closeMenu();
    } else if (e.key === 'Tab') {
      handleTabKey(e);
    }
  });
</script>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .site-header {
    position: relative;
    z-index: 1;
  }

  .site-header__top {
    @include breakpoint(md) {
      display: flex;
      justify-content: flex-end;
      padding: $spacing-unit * 2 $spacing-unit * 4;
    }
  }

  .site-header__announcement {
    font-family: $font-family-ui;
    font-size: 1.6rem;
    line-height: 1;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: $color-white;
    background: $color-orange;
    padding: $spacing-unit * 1.5 $spacing-unit * 2;
    text-align: center;
    margin-bottom: $spacing-unit * 5;

    @include breakpoint(md) {
      padding: $spacing-unit $spacing-unit * 2;
      border-radius: 8rem;
      margin-bottom: 0;
    }
  }

  .site-header__navbar {
    background: $color-charcoal;
    border-top: $spacing-unit * 0.5 solid $color-white;
    border-bottom: $spacing-unit * 0.5 solid $color-white;
    box-shadow: 0 0 3rem rgba(0, 0, 0, 0.2);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $spacing-unit * 2;
    padding: $spacing-unit $spacing-unit * 2;

    @include breakpoint(md) {
      padding: $spacing-unit $spacing-unit * 4;
    }
  }

  .site-header__logo {
    display: block;
    flex-shrink: 0;
    margin-top: -$spacing-unit * 6;
    margin-bottom: -$spacing-unit * 6;

    img {
      display: block;
      width: 12rem;
      height: 12rem;
      height: auto;
    }
  }

  .site-header__nav {
    display: none;
    column-gap: $spacing-unit * 4;
    row-gap: $spacing-unit;
    flex-wrap: wrap;

    @include breakpoint(md) {
      display: flex;
    }
  }

  .site-header__nav-link {
    font-family: $font-family-ui;
    font-size: 2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: $color-white;
    text-decoration: none;
    transition: color 0.2s;

    &:hover {
      color: $color-orange;
    }
  }

  .site-header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    width: 3.2rem;
    height: 3.2rem;
    padding: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;

    @include breakpoint(md) {
      display: none;
    }
  }

  .site-header__hamburger-line {
    display: block;
    width: 100%;
    height: 0.3rem;
    background: $color-white;
    border-radius: 0.2rem;
  }

  // Mobile Nav Overlay
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;

    &.is-open {
      visibility: visible;
      pointer-events: auto;

      .mobile-nav__overlay {
        opacity: 1;
      }

      .mobile-nav__panel {
        transform: translateX(0);
      }
    }
  }

  .mobile-nav__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-nav__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(32rem, 85vw);
    background: $color-forest;
    padding: $spacing-unit * 4;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: $spacing-unit * 5;
  }

  .mobile-nav__close {
    align-self: flex-end;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: none;
    border: none;
    color: $color-white;
    cursor: pointer;
    transition: color 0.2s;

    &:hover {
      color: $color-orange;
    }
  }

  .mobile-nav__links {
    display: flex;
    flex-direction: column;
    gap: $spacing-unit * 2;
  }

  .mobile-nav__link {
    @include eyebrow;
    color: $color-white;
    text-decoration: none;
    margin-bottom: 0;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .mobile-nav__contact {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-unit * 1.5;
  }

  .mobile-nav__heading {
    @include eyebrow;
    color: $color-orange;
    margin-bottom: 0;
  }

  .mobile-nav__contact-link {
    @include eyebrow;
    color: $color-white;
    text-decoration: none;
    margin-bottom: 0;
    transition: color 0.2s;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
