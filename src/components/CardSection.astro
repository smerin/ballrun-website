---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="card-section">
  <h2>{title}</h2>
  <div class="card-section__grid">
    <slot />
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .card-section {
    padding: $spacing-unit * 8 $spacing-unit * 3;
    text-align: center;

    @include breakpoint(md) {
      padding: $spacing-unit * 10 $spacing-unit * 4;
    }

    @include breakpoint(lg) {
      padding: $spacing-unit * 12 $spacing-unit * 8;
    }
  }

  .card-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-unit * 3;
    margin-top: $spacing-unit * 6;
    max-width: 140rem;
    margin-left: auto;
    margin-right: auto;
    text-align: left;

    @include breakpoint(md) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
