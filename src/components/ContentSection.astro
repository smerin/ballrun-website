---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  images?: {
    src: ImageMetadata;
    alt: string;
  }[];
  variant?: 'default' | 'white' | 'charcoal' | 'forest';
}

const { title, description, images, variant = 'default' } = Astro.props;
---

<section class={`content-section content-section--${variant}`}>
  <div class="content-section__inner">
    <h2>{title}</h2>
    <Fragment set:html={description} />
  </div>

  {images && images.length > 0 && (
    <div class="content-section__images">
      {images.map((image) => (
        <Image
          src={image.src}
          alt={image.alt}
          width={300}
          height={300}
          fit="cover"
        />
      ))}
    </div>
  )}
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .content-section {
    padding: $spacing-unit * 8 $spacing-unit * 4;

    @include breakpoint(md) {
      padding: $spacing-unit * 12 $spacing-unit * 8;
    }

    &--white {
      background-color: $color-white;
      box-shadow: 0 0 3rem rgba(0, 0, 0, 0.2);
    }

    &--charcoal {
      background-color: $color-charcoal;
      color: $color-white;
    }

    &--forest {
      background-color: $color-forest;
      color: $color-white;
    }
  }

  .content-section__inner {
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }

  .content-section__images {
    display: flex;
    gap: $spacing-unit * 3;
    margin-top: $spacing-unit * 6;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 $spacing-unit * 4;
    margin-left: -$spacing-unit * 4;
    margin-right: -$spacing-unit * 4;

    // Hide scrollbar but keep functionality
    scrollbar-width: none;
    -ms-overflow-style: none;
    &::-webkit-scrollbar {
      display: none;
    }

    img {
      border-radius: 1rem;
      scroll-snap-align: center;
      flex-shrink: 0;
    }

    @media (min-width: 1044px) {
      justify-content: center;
      overflow-x: visible;
      scroll-snap-type: none;
      padding: 0;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
