---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  images?: {
    src: ImageMetadata;
    alt: string;
  }[];
  backgroundImage?: {
    src: ImageMetadata;
    alt: string;
  };
  variant?: 'default' | 'white' | 'charcoal' | 'forest';
}

const { title, description, images, backgroundImage, variant = 'default' } = Astro.props;
---

<section class="content-section" data-variant={variant} data-has-background={backgroundImage ? "" : undefined}>
  {backgroundImage && (
    <div class="content-section__background">
      <Image
        src={backgroundImage.src}
        alt={backgroundImage.alt}
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
      />
    </div>
  )}
  <div class="content-section__inner">
    <h2>{title}</h2>
    <Fragment set:html={description} />
  </div>

  {images && images.length > 0 && (
    <div class="content-section__images">
      {images.map((image) => (
        <Image
          src={image.src}
          alt={image.alt}
          width={300}
          height={300}
          fit="cover"
        />
      ))}
    </div>
  )}
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .content-section {
    position: relative;
    padding: $spacing-unit * 8 $spacing-unit * 3;

    @include breakpoint(md) {
      padding: $spacing-unit * 12 $spacing-unit * 8;
    }

    &[data-variant="white"] {
      background-color: $color-white;
      box-shadow: 0 0 3rem rgba(0, 0, 0, 0.2);
    }

    &[data-variant="charcoal"] {
      background-color: $color-charcoal;
      color: $color-white;
    }

    &[data-variant="forest"] {
      background-color: $color-forest;
      color: $color-white;
    }

    &[data-has-background] {
      color: $color-charcoal;
      overflow: hidden;

      @include breakpoint(md) {
        min-height: 70svh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
    }
  }

  .content-section__background {
    position: absolute;
    inset: 0;
    z-index: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .content-section__inner {
    position: relative;
    z-index: 1;
    max-width: 60rem;
    margin: 0 auto;
    text-align: left;

    @include breakpoint(md) {
      text-align: center;
    }

    .content-section[data-has-background] & {
      background: rgba($color-white, 0.8);
      padding: $spacing-unit * 3;
      border-radius: 1rem;

      @include breakpoint(md) {
        padding: $spacing-unit * 6;
      }
    }
  }

  .content-section__images {
    display: flex;
    gap: $spacing-unit * 3;
    margin-top: $spacing-unit * 6;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 $spacing-unit * 4;
    margin-left: -$spacing-unit * 4;
    margin-right: -$spacing-unit * 4;

    // Hide scrollbar but keep functionality
    scrollbar-width: none;
    -ms-overflow-style: none;
    &::-webkit-scrollbar {
      display: none;
    }

    img {
      border-radius: 1rem;
      scroll-snap-align: center;
      flex-shrink: 0;
    }

    @media (min-width: 1044px) {
      justify-content: center;
      overflow-x: visible;
      scroll-snap-type: none;
      padding: 0;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
