---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  linkText: string;
  linkHref: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { title, description, linkText, linkHref, image, imageAlt } = Astro.props;
---

<article class="card">
  <Image
    src={image}
    alt={imageAlt}
    class="card__image"
    widths={[400, 600, 800]}
    sizes="(min-width: 768px) 50vw, 100vw"
  />
  <div class="card__overlay"></div>
  <div class="card__content">
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={linkHref} class="card__link">{linkText}</a>
  </div>
</article>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .card {
    position: relative;
    min-height: 40rem;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: 1.5rem;
  }

  .card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0,
      rgba(0, 0, 0, 0.7) 100%
    );
    z-index: -1;
  }

  .card__content {
    padding: $spacing-unit * 3;
    color: $color-white;

    @include breakpoint(md) {
      padding: $spacing-unit * 4;
    }

    h3,
    p {
      margin-bottom: $spacing-unit * 2;
    }

    p {
      max-width: 50rem;
    }
  }

  .card__link {
    @include text-link;
  }
</style>
