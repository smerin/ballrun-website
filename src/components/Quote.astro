---
interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
---

<blockquote class="quote">
  <p class="quote__text">{quote}</p>
  {attribution && <cite class="quote__attribution">{attribution}</cite>}
</blockquote>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .quote {
    margin: 0;
    padding-left: $spacing-unit * 3;
    border-left: 0.375rem solid $color-orange;

    @include breakpoint(md) {
      padding-left: $spacing-unit * 5;
      border-left-width: 0.5rem;
    }
  }

  .quote__text {
    font-family: $font-family-heading;
    font-size: 1.75rem;
    font-style: italic;
    line-height: 1.4;
    margin: 0;

    @include breakpoint(md) {
      font-size: 2.5rem;
    }
  }

  .quote__attribution {
    @include eyebrow;
    font-style: normal;
    margin-top: $spacing-unit * 2;

    @include breakpoint(md) {
      margin-top: $spacing-unit * 3;
    }
  }
</style>
